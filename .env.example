# Скопируйте этот файл в .env.local и подставьте свои значения.
# .env.local в git не попадает (см. .gitignore), поэтому ключи остаются локально.
#
# EmailJS — https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Telegram — používá Netlify Function (server-side, BEZ prefixu VITE_,
# aby se token nedostal do prohlížeče). Nastavit v Netlify:
#   Site settings → Environment variables.
# Bot vytvoříte přes @BotFather, chat_id zjistíte přes @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
