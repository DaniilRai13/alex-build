# Скопируйте этот файл в .env.local и подставьте свои значения.
# .env.local в git не попадает (см. .gitignore), поэтому ключи остаются локально.
#
# EmailJS — https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Telegram (Forpsi/PHP): token a chat_id se nastavují v souboru
# public/telegram-config.php (viz public/telegram-config.example.php),
# NE zde – ten je server-side a do prohlížeče se nedostane.
