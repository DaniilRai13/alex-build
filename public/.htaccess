# Forpsi / Apache – servírování předrenderovaných stránek a SPA fallback.

Options -MultiViews
RewriteEngine On

# Sjednocení domény: www -> bez www (kanonická verze v celém kódu je bez www).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Existující soubory a složky (assety, .php, obrázky) servírovat přímo.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Čisté URL na předrenderované stránky: /services -> /services.html
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ /$1.html [L]

# Vše ostatní na SPA (klientské routování, 404 řeší React).
RewriteRule ^ /index.html [L]

# --- Komprese ---
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Cache pro statické assety (mají hash v názvu) ---
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType text/html "access plus 0 seconds"
</IfModule>
