# Forpsi / Apache – servírování předrenderovaných stránek.

Options -MultiViews
# No directory listings: /services/ and /project/ are real folders full of
# prerendered pages and must never be browsable.
Options -Indexes

# Apache must never append a trailing slash to a directory request. mod_dir
# answering a folder with a redirect to <folder>/ is the first half of a loop
# that the slash-stripping rule below completes, and a looping URL is
# unreachable for crawlers and for anyone opening it directly.
#
# That loop is what took /services and /project down. Those two are now handled
# before a folder can reach mod_dir — the .html rule catches /services, an
# explicit redirect catches /project — so this line is what covers everything
# else: /static-loader-data today, and any folder a future build drops into
# dist/ without a page beside it. Nothing here is meant to be browsed as a
# directory anyway (see -Indexes).
#
# Needs AllowOverride Indexes. If Forpsi does not grant it, Apache answers 500
# for the whole site — check the site loads right after deploying and drop this
# line if it does not.
DirectorySlash Off

RewriteEngine On

# The two *-config.php files hold the Telegram token and the Supabase service
# key. PHP normally executes them and returns nothing, so they are already
# invisible — but if PHP ever stopped running, Apache would hand out the source
# and with it the keys. Refusing them outright costs nothing and removes that
# one bad day entirely.
<FilesMatch "-config(\.example)?\.php$">
	Require all denied
</FilesMatch>

# Sjednocení domény: www -> bez www (kanonická verze v celém kódu je bez www).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# /project holds the project pages but has no page of its own, so the bare URL
# has nothing to serve. Send it to the portfolio. Matching the trailing slash
# here too keeps it to a single hop instead of bouncing through the rule below.
RewriteRule ^project/?$ /portfolio [R=301,L]

# One canonical URL shape: /services/ redirects to /services, so the same page
# is never reachable under two addresses.
#
# The scheme is spelled out rather than left relative. Forpsi terminates TLS in
# front of us and speaks plain HTTP to Apache, so Apache builds an http://
# Location, the hosting bounces it back to https://, and every redirect costs
# two extra hops — which is what turned the loop above into a four-step one.
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# Čisté URL na předrenderované stránky: /services -> /services.html
#
# This has to run BEFORE the rule for existing files and folders. /services
# satisfies -d because the folder exists, and passing the request through hands
# it to Apache's directory handler instead of serving the page sitting right
# next to that folder.
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ /$1.html [L]

# Existující soubory a složky (assety, .php, obrázky) servírovat přímo.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Every route is prerendered, so anything left over really does not exist:
# let Apache answer with a genuine 404 status and serve the prerendered
# 404 page. Falling back to /index.html used to return HTTP 200 with the
# home page markup, which search engines index as a soft 404.
ErrorDocument 404 /404.html

# --- Komprese ---
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Cache pro statické assety (mají hash v názvu) ---
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType text/html "access plus 0 seconds"
</IfModule>
