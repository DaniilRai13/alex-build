# Forpsi / Apache – servírování předrenderovaných stránek.

Options -MultiViews
# No directory listings: /services/ and /portfolio/ are real folders full of
# prerendered pages and must never be browsable.
Options -Indexes

# Apache must never append a trailing slash to a directory request. mod_dir
# answering a folder with a redirect to <folder>/ is the first half of a loop
# that the slash-stripping rule below completes, and a looping URL is
# unreachable for crawlers and for anyone opening it directly.
#
# That loop is what took /services and /project down. Both branches now have a
# page beside the folder — services.html next to services/, portfolio.html next
# to portfolio/ — so the .html rule below claims them before mod_dir ever sees
# a directory. This line covers everything else: /static-loader-data today, and
# any folder a future build drops into dist/ without a page beside it. Nothing
# here is meant to be browsed as a directory anyway (see -Indexes).
#
# Needs AllowOverride Indexes. If Forpsi does not grant it, Apache answers 500
# for the whole site — check the site loads right after deploying and drop this
# line if it does not.
DirectorySlash Off

RewriteEngine On

# The two *-config.php files hold the Telegram token and the Supabase service
# key. PHP normally executes them and returns nothing, so they are already
# invisible — but if PHP ever stopped running, Apache would hand out the source
# and with it the keys. Refusing them outright costs nothing and removes that
# one bad day entirely.
<FilesMatch "-config(\.example)?\.php$">
	Require all denied
</FilesMatch>

# Sjednocení domény: www -> bez www (kanonická verze v celém kódu je bez www).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Project pages moved from /project/<slug> to /portfolio/<slug>, so the listing
# and the things it lists finally share a branch. The nine old URLs are indexed
# and linked from outside, so these two redirects are permanent — deleting them
# later would 404 every project result Google still holds.
#
# Absolute https, not a relative target: Forpsi terminates TLS, so Apache
# believes it is serving plain HTTP and builds the Location header with that
# scheme. The relative form sent https://kartstav.cz/project to
# http://kartstav.cz/portfolio, which the HTTPS rule then had to bounce back up
# — two hops and a plaintext one in the middle, for what is one redirect.
RewriteRule ^project/(.+?)/?$ https://%{HTTP_HOST}/portfolio/$1 [R=301,L]
RewriteRule ^project/?$ https://%{HTTP_HOST}/portfolio [R=301,L]

# One canonical URL shape: /services/ redirects to /services, so the same page
# is never reachable under two addresses.
#
# The scheme is spelled out rather than left relative. Forpsi terminates TLS in
# front of us and speaks plain HTTP to Apache, so Apache builds an http://
# Location, the hosting bounces it back to https://, and every redirect costs
# two extra hops — which is what turned the loop above into a four-step one.
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# Čisté URL na předrenderované stránky: /services -> /services.html
#
# This has to run BEFORE the rule for existing files and folders. /services
# satisfies -d because the folder exists, and passing the request through hands
# it to Apache's directory handler instead of serving the page sitting right
# next to that folder.
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ /$1.html [L]

# Existující soubory a složky (assety, .php, obrázky) servírovat přímo.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Every route is prerendered, so anything left over really does not exist:
# let Apache answer with a genuine 404 status and serve the prerendered
# 404 page. Falling back to /index.html used to return HTTP 200 with the
# home page markup, which search engines index as a soft 404.
ErrorDocument 404 /404.html

# --- HSTS ---
# Tell the browser to reach this host over HTTPS by itself, so a typed or
# pasted http:// address stops costing a redirect — and cannot be intercepted
# on that first hop.
#
# No includeSubDomains and no preload on purpose: both are hard to walk back
# (preload means asking a browser vendor to remove the entry), and they would
# commit every future subdomain to HTTPS before anyone has checked it.
<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# --- Komprese ---
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Cache pro statické assety (mají hash v názvu) ---
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	# WebP is what <picture> actually serves to every current browser — without
	# this line the format carrying almost all of the page weight was the one
	# format not being cached.
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType text/html "access plus 0 seconds"
</IfModule>
